
{
  "ai": {
    "provider": "deepseek",
    "model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "temperature": 0.3,
    "languages": ["zh", "en"]
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 5.0,
        "topic_dedup": true
      },
      "finance-news": {
        "threshold": 5.0,
        "topic_dedup": true
      }
    }
  },
  "sources": {
    "rss": [
      {
        "name": "Amazon US Seller News",
        "url": "https://news.google.com/rss/search?q=Amazon%20FBA%20OR%20Amazon%20seller%20fees&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "amazon",
        "profile": "tech-news"
      },
      {
        "name": "US Economy",
        "url": "https://news.google.com/rss/search?q=US%20consumer%20spending%20OR%20retail%20sales%20OR%20unemployment&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "economy",
        "profile": "finance-news"
      },
      {
        "name": "AI News",
        "url": "https://news.google.com/rss/search?q=OpenAI%20OR%20Anthropic%20OR%20AI%20agents&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "ai",
        "profile": "tech-news"
      },
      {
        "name": "Cross Border Ecommerce",
        "url": "https://news.google.com/rss/search?q=US%20tariffs%20OR%20ecommerce%20shipping&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "ecommerce",
        "profile": "finance-news"
      },
      {
        "name": "Promotional Products Industry",
        "url": "https://news.google.com/rss/search?q=promotional%20products%20industry%20OR%20ASI%20distributors&hl=en-US&gl=US&ceid=US:en",
        "enabled": true,
        "category": "ecommerce",
        "profile": "finance-news"
      }
    ]
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 16,
    "category_groups": {
      "amazon": {
        "limit": 4,
        "categories": ["amazon"]
      },
      "economy": {
        "limit": 4,
        "categories": ["economy"]
      },
      "ai": {
        "limit": 4,
        "categories": ["ai"]
      },
      "ecommerce": {
        "limit": 4,
        "categories": ["ecommerce"]
      }
    },
    "default_group": "other",
    "default_group_limit": 1
  },
  "webhook": {
    "enabled": false
  }
}
